# Mot de passe PostgreSQL local (obligatoire pour compose). Ne jamais committer le vrai .env.
POSTGRES_PASSWORD=change-me
# PostgreSQL connection used for durable agent and conversation state.
DATABASE_URL=postgresql://agent:change-me@localhost:5432/agent
DATABASE_SSL=false
# Server-only token used by the web proxy to access the external-agent gateway.
AGENT_GATEWAY_TOKEN=change-me-long-random-token
# Optional API base URL used by the web server when proxying gateway requests.
API_URL=http://localhost:4000
# Optional OpenAI-compatible model gateway configuration. Keys remain API-server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional compatible endpoint, e.g. a self-hosted gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
# Gemini / Google AI Studio (server-only).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
